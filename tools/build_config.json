{
    "zip_root": "MyToolkit",
    "max_part_mb": 20,
    "min_houdini": "19.5",
    "base_url": "https://houdini-toolkit.pages.dev",
    "shelf_index": {
        "file": "shelves.json",
        "name": "阿龙工具",
        "author": "阿龙",
        "description": "一键安装 / 更新的 Houdini 工具集。下载后工具架里会出现「阿龙工具」，点按钮即可装齐工具架、Python 模块与预设，之后每次点击自动检查更新。",
        "base_url": "https://zz980304-lab.github.io/houdini-toolkit",
        "_base_url_note": "Download Shelf 下载文件走的是 urllib，UA 为 Python-urllib/3.11，Cloudflare Pages 会直接返回 403。GitHub Pages 不拦，所以清单里的 fileURL / thumbnailURL 一律指向 github.io。（清单本身是 requests 拉的，pages.dev 也能给。）",
        "thumbnail": "icon.png",
        "_thumbnail_note": "必须给：字段缺失时 Houdini 会拿空字符串去下载，失败后清理临时文件又会抛 PermissionError(WinError 32)，照样弹框。指向 github.io 的图能正常下载。",
        "target": "bootstrap.shelf"
    },
    "_sources_note": "每个 sources 里 N:/Houdini_path/... 排在前面 = 以 N 盘为唯一真相源；src/ 是仓库里的副本，只在 N 盘不在时兜底。改完 N 盘直接 build 就能生效，不用手工同步。",
    "modules": [
        {
            "id": "core",
            "name": "核心工具（工具架 + Python + 预设）",
            "default": true,
            "enabled": true,
            "sources": [
                { "src": "N:/Houdini_path/toolbar", "dst": "toolbar",
                  "include": ["*.shelf"],
                  "exclude": ["backup", "downloads", "bootstrap.shelf"] },
                { "src": "N:/Houdini_path/python3.11libs", "dst": "python3.11libs",
                  "exclude": ["__pycache__", "*.pyc", "backup"] },
                { "src": "N:/Houdini_path/presets", "dst": "presets",
                  "exclude": ["backup"] },
                { "src": "src/toolbar", "dst": "toolbar",
                  "include": ["*.shelf"], "exclude": ["backup"] },
                { "src": "src/python3.11libs", "dst": "python3.11libs",
                  "exclude": ["__pycache__", "*.pyc"] },
                { "src": "src/presets", "dst": "presets" }
            ]
        },
        {
            "id": "otls-misc",
            "name": "自收集 HDA / 节点库（不含 ql 与 ffx 大包）",
            "default": true,
            "enabled": true,
            "sources": [
                { "src": "N:/Houdini_path/otls", "dst": "otls",
                  "include": ["*.hda", "*.otl", "*.hdalc", "*.otllc"],
                  "exclude": ["*_ql_*", "backup", "ffx_collection_a_blackbox.hda"] }
            ]
        },
        {
            "id": "otls-ffx",
            "name": "ffx 节点集（91MB 黑盒包，装一次基本不动）",
            "default": false,
            "enabled": true,
            "sources": [
                { "src": "N:/Houdini_path/otls/ffx_collection_a_blackbox.hda",
                  "dst": "otls" }
            ]
        },
        {
            "id": "otls-ql",
            "name": "ql 节点库（约 200 个）",
            "default": false,
            "enabled": true,
            "sources": [
                { "src": "N:/Houdini_path/otls", "dst": "otls",
                  "include": ["*_ql_*"], "exclude": ["backup"] }
            ]
        }
    ]
}
