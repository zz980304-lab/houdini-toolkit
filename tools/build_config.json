{
    "zip_root": "MyToolkit",
    "max_part_mb": 20,
    "min_houdini": "19.5",
    "base_url": "https://houdini-toolkit.pages.dev",
    "shelf_index": {
        "file": "shelves.json",
        "name": "阿龙工具",
        "author": "阿龙",
        "description": "一键安装 / 更新的 Houdini 工具集。下载后工具架里会出现「阿龙工具」，点按钮即可装齐工具架、Python 模块与预设，之后每次点击自动检查更新。",
        "thumbnail": null,
        "_thumbnail_note": "Houdini 20.5 的 assetdownload.downloadAssetThumbnail 在 Windows 上有 bug：mkstemp 建好临时文件后，又把下载结果 move 到同一路径，Windows 下必然失败并抛 PermissionError(WinError 32)。所以这里留空，Houdini 就不会去下载缩略图，也就不会弹错。icon.png 仍然保留，浏览器里可以用作展示。",
        "target": "bootstrap.shelf"
    },
    "modules": [
        {
            "id": "core",
            "name": "核心工具（工具架 + Python + 预设）",
            "default": true,
            "enabled": true,
            "sources": [
                { "src": "src/toolbar", "dst": "toolbar" },
                { "src": "src/python3.11libs", "dst": "python3.11libs",
                  "exclude": ["__pycache__", "*.pyc"] },
                { "src": "src/presets", "dst": "presets" }
            ]
        },
        {
            "id": "otls-misc",
            "name": "自收集 HDA / 第三方节点（不含 ql 库）",
            "default": true,
            "enabled": false,
            "sources": [
                { "src": "N:/Houdini_path/otls", "dst": "otls",
                  "include": ["*.hda", "*.otl"],
                  "exclude": ["*_ql_*", "backup"] }
            ]
        },
        {
            "id": "otls-ql",
            "name": "ql 节点库（254 个）",
            "default": false,
            "enabled": false,
            "sources": [
                { "src": "N:/Houdini_path/otls", "dst": "otls",
                  "include": ["*_ql_*"] }
            ]
        }
    ]
}
